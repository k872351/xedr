# Isolated backend quality checks. This image does not start the application.
FROM python:3.13-slim
WORKDIR /workspace
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
COPY requirements.txt .
RUN python -m pip install --no-cache-dir -r requirements.txt
COPY backend/ backend/
COPY scripts/ scripts/
RUN python -m pip check && python scripts/check_dependency_versions.py
CMD ["python", "-m", "unittest", "discover", "-s", "backend", "-t", ".", "-p", "test_*.py", "-v"]
